{
  "background_color": "#f3f3fa",
  "description": "Quick Link — PC と Android をつなぐ連携アプリ（通知・メッセージ・写真・ファイル共有）",
  "display": "standalone",
  "icons": [
    { "purpose": "any", "sizes": "192x192", "src": "/icons/icon-192.png", "type": "image/png" },
    { "purpose": "any", "sizes": "512x512", "src": "/icons/icon-512.png", "type": "image/png" },
    { "purpose": "maskable", "sizes": "512x512", "src": "/icons/icon-maskable-512.png", "type": "image/png" }
  ],
  "lang": "ja",
  "name": "Quick Link",
  "scope": "/",
  "short_name": "Quick Link",
  "start_url": "/",
  "theme_color": "#f3f3fa",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  },
  "shortcuts": [
    { "name": "スマートフォンに送信", "short_name": "送信", "url": "/?share=1" },
    { "name": "通知", "short_name": "通知", "url": "/?view=notifs" },
    { "name": "メッセージ", "short_name": "メッセージ", "url": "/?view=messages" }
  ]
}
